{
  "name": "openvoice",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hostable browser voice, chat, and video tool.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --sort --if-present build",
    "format": "prettier \"apps/**/*.{html,json,ts}\" \"packages/**/*.{json,ts}\" \"infra/*.{yaml,yml}\" \"*.{json,md,mjs,yaml,yml}\" \"docs/decision-log.md\" \"pnpm-workspace.yaml\" --write",
    "format:check": "prettier \"apps/**/*.{html,json,ts}\" \"packages/**/*.{json,ts}\" \"infra/*.{yaml,yml}\" \"*.{json,md,mjs,yaml,yml}\" \"docs/decision-log.md\" \"pnpm-workspace.yaml\" --check",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vite": "7.2.7",
    "vitest": "4.0.15"
  }
}
