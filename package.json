{
  "name": "openvoice",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hostable browser voice, chat, and video tool.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "vite": "7.3.2"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --sort --if-present build",
    "env:local": "node scripts/create-local-env.mjs",
    "db:migrate": "pnpm --filter @openvoice/api build && pnpm --filter @openvoice/api migrate",
    "docker:export": "node scripts/export-docker-images.mjs",
    "format": "prettier \"apps/**/*.{html,json,ts}\" \"packages/**/*.{json,ts}\" \"scripts/*.mjs\" \"infra/*.{yaml,yml}\" \"*.{json,md,mjs,yaml,yml}\" \"docs/{api,backup-restore,data-retention,decision-log,deployment,e2e-test-matrix,security,testing}.md\" \"pnpm-workspace.yaml\" --write",
    "format:check": "prettier \"apps/**/*.{html,json,ts}\" \"packages/**/*.{json,ts}\" \"scripts/*.mjs\" \"infra/*.{yaml,yml}\" \"*.{json,md,mjs,yaml,yml}\" \"docs/{api,backup-restore,data-retention,decision-log,deployment,e2e-test-matrix,security,testing}.md\" \"pnpm-workspace.yaml\" --check",
    "license:check": "node scripts/check-licenses.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vite": "7.3.2",
    "vitest": "4.0.15"
  }
}
