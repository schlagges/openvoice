NODE_ENV=development

APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000/api
GATEWAY_PUBLIC_URL=ws://localhost:3000/api/v1/gateway
VITE_API_BASE_URL=/api/v1
API_PORT=3000
WEB_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ENABLE_HSTS=false

POSTGRES_DB=openvoice
POSTGRES_USER=openvoice
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=55436
DATABASE_URL=postgres://openvoice:replace-with-local-postgres-password@localhost:55436/openvoice

VALKEY_PORT=6379
REDIS_URL=redis://localhost:6379

SESSION_SECRET=replace-with-generated-session-secret
CSRF_SECRET=replace-with-generated-csrf-secret
PASSWORD_PEPPER=replace-with-generated-password-pepper
SESSION_COOKIE_NAME=openvoice_session
SESSION_TTL_SECONDS=2592000
SESSION_COOKIE_SECURE=false

TURN_REALM=voice.example.com
TURN_URL=localhost
TURN_SHARED_SECRET=replace-with-generated-turn-shared-secret
TURN_TTL_SECONDS=1200
TURN_PORT=3478
TURNS_PORT=5349
TURN_RELAY_PORTS=49152-49200
TURN_METRICS_PORT=9641

MEDIA_PROVIDER=livekit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-livekit-api-secret-32chars
LIVEKIT_TOKEN_TTL_SECONDS=600
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORTS=50000-50100

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-local-grafana-password
